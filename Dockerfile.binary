# Run using precompiled binary
# Smaller image, faster startup, and lower memory usage
#
# Build steps:
# 1. Run `npm run build:linux` or `npm run build:linux-arm64` to generate the dist directory
# 2. Run `docker build -f Dockerfile.binary -t antigravity .`

FROM debian:bookworm-slim

WORKDIR /app

# Install required runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy precompiled files (built by CI workflow)
# Use wildcard to match architecture-specific binary
COPY dist/antigravity-linux-* /app/antigravity
COPY dist/public /app/public
COPY dist/bin /app/bin
COPY dist/src/utils/proto /app/src/utils/proto
COPY dist/config.json /app/config.json
COPY dist/src/config/upstream.json /app/src/config/upstream.json

# Set executable permissions
RUN chmod +x /app/antigravity && \
    (chmod +x /app/bin/* 2>/dev/null || true)

# Create data/images directories and default .env file
RUN mkdir -p /app/data /app/public/images && \
    echo "# Sensitive configuration (configure only in .env)" > /app/.env && \
    echo "# If left unset, random credentials will be auto-generated and printed on startup" >> /app/.env && \
    echo "# API_KEY=your-api-key" >> /app/.env && \
    echo "# ADMIN_USERNAME=your-username" >> /app/.env && \
    echo "# ADMIN_PASSWORD=your-password" >> /app/.env && \
    echo "# JWT_SECRET=your-jwt-secret" >> /app/.env && \
    echo "" >> /app/.env && \
    echo "# Optional configuration" >> /app/.env && \
    echo "# PROXY=http://127.0.0.1:7890" >> /app/.env && \
    echo "" >> /app/.env && \
    echo "# Proxy system instruction" >> /app/.env && \
    echo "SYSTEM_INSTRUCTION=" >> /app/.env && \
    echo "" >> /app/.env && \
    echo "# Official system prompt (leave empty to use built-in default)" >> /app/.env && \
    echo "# OFFICIAL_SYSTEM_PROMPT=" >> /app/.env && \
    echo "" >> /app/.env && \
    echo "# IMAGE_BASE_URL=http://your-domain.com" >> /app/.env

# Create entrypoint script to sync environment variables into .env
RUN cat > /app/entrypoint.sh << 'EOF'
#!/bin/sh
# Sync environment variables to .env file
ENV_FILE="/app/.env"

# Function to sync a single environment variable
# Uses ${var+x} syntax to detect whether the variable is set (including empty values)
sync_env() {
  key=$1
  # Check if environment variable is set (including empty string)
  if eval "[ \"\${${key}+x}\" ]"; then
    value=$(eval echo \"\$$key\")
    # Check if entry already exists
    if grep -q "^${key}=" "$ENV_FILE" 2>/dev/null; then
      # Replace existing value (using # as delimiter to avoid conflicts with special chars)
      sed -i "s#^${key}=.*#${key}=${value}#" "$ENV_FILE"
    else
      # Append new entry
      echo "${key}=${value}" >> "$ENV_FILE"
    fi
    if [ -n "$value" ]; then
      echo "✓ Synced env var: ${key}=${value}"
    else
      echo "✓ Synced env var: ${key}=(empty)"
    fi
  fi
}

# Sync all supported environment variables
sync_env "API_KEY"
sync_env "ADMIN_USERNAME"
sync_env "ADMIN_PASSWORD"
sync_env "JWT_SECRET"
sync_env "PROXY"
sync_env "SYSTEM_INSTRUCTION"
sync_env "OFFICIAL_SYSTEM_PROMPT"
sync_env "IMAGE_BASE_URL"

# Start application
exec /app/antigravity
EOF
RUN chmod +x /app/entrypoint.sh

# Expose port
EXPOSE 8045

# Start application
CMD ["/app/entrypoint.sh"]
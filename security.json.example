{
  "whitelist": {
    "enabled": true,
    "ips": [
      "127.0.0.1",
      "::1"
    ],
    "comment": "Whitelisted IPs are never blocked; private/LAN IP ranges are automatically whitelisted"
  },
  "blocking": {
    "enabled": true,
    "tempBlockDuration": 3600000,
    "maxViolationsBeforeTempBlock": 50,
    "maxTempBlocksBeforePermanent": 10,
    "violationWindow": 300000,
    "violationDecayTime": 1800000,
    "comment": "Blocking config: 1h temp block after 50 violations within 5 minutes; 10 temp blocks trigger a permanent ban"
  }
}
